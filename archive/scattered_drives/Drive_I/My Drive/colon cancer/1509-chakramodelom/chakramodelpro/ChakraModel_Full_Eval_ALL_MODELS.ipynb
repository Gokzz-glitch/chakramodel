    "# CELL 6 — Load YOLOv8n-Seg\n",
    "from ultralytics import YOLO\n",
    "\n",
    "yolo_model = YOLO(WEIGHTS['yolo'])\n",
    "print(f'YOLOv8n-Seg loaded | task={yolo_model.task} | names={yolo_model.names}')\n",
    "\n",
    "def predict_yolo_mask(img_bgr, conf=0.25):\n",
    "    H, W = img_bgr.shape[:2]\n",
    "    results = yolo_model(img_bgr, conf=conf, verbose=False)[0]\n",
    "    mask = np.zeros((H, W), dtype=np.uint8)\n",
    "    if results.masks is not None:\n",
    "        for m in results.masks.data:\n",
    "            m_np = m.cpu().numpy()\n",
    "            m_rs = cv2.resize(m_np, (W, H), interpolation=cv2.INTER_NEAREST)\n",
    "            mask = np.maximum(mask, (m_rs > 0.5).astype(np.uint8))\n",
    "    return mask\n",
    "\n",
    "dummy = np.zeros((384,384,3), dtype=np.uint8)\n",
    "print(f'YOLO sanity: output shape {predict_yolo_mask(dummy).shape}')"
   ]
  },
  {
   "cell_type": "code",
