    "# CELL 3 — Shared metric functions\n",
    "import numpy as np\n",
    "import cv2\n",
    "import torch\n",
    "\n",
    "IMG_SIZE = 384\n",
    "MEAN = np.array([0.485, 0.456, 0.406], dtype=np.float32)\n",
    "STD  = np.array([0.229, 0.224, 0.225], dtype=np.float32)\n",
    "THRESH = 0.7  # tuned in prior video eval on CVC-300\n",
    "\n",
    "def preprocess(img_bgr, size=IMG_SIZE):\n",
    "    img = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
    "    img = cv2.resize(img, (size, size), interpolation=cv2.INTER_LINEAR)\n",
    "    img = img.astype(np.float32) / 255.0\n",
    "    img = (img - MEAN) / STD\n",
    "    return torch.from_numpy(img.transpose(2,0,1)).unsqueeze(0)\n",
    "\n",
    "def dice(pred, gt, eps=1e-7):\n",
    "    p, g = pred.astype(bool), gt.astype(bool)\n",
    "    return float((2*(p&g).sum()+eps)/(p.sum()+g.sum()+eps))\n",
    "\n",
    "def iou(pred, gt, eps=1e-7):\n",
    "    p, g = pred.astype(bool), gt.astype(bool)\n",
    "    return float(((p&g).sum()+eps)/((p|g).sum()+eps))\n",
    "\n",
    "def fbeta(pred, gt, b2=0.3, eps=1e-7):\n",
    "    p, g = pred.astype(bool), gt.astype(bool)\n",
    "    tp = (p&g).sum(); fp = (p&~g).sum(); fn = (~p&g).sum()\n",
    "    prec = tp/(tp+fp+eps); rec = tp/(tp+fn+eps)\n",
    "    return float((1+b2)*prec*rec/(b2*prec+rec+eps))\n",
    "\n",
    "def get_test_images(ds_name):\n",
    "    cfg = DATASETS[ds_name]\n",
    "    spl = SPLIT[ds_name]\n",
    "    img_dir = cfg['img']\n",
    "    msk_dir = cfg['msk']\n",
    "    IMG_EXTS = ('.png', '.jpg', '.jpeg', '.tif', '.bmp')\n",
    "    imgs = sorted([p for p in Path(img_dir).iterdir()\n",
    "                   if p.suffix.lower() in IMG_EXTS])\n",
    "    if spl['test_n'] is not None:\n",
    "        if spl.get('from_end'):\n",
    "            imgs = imgs[-spl['test_n']:]\n",
    "        else:\n",
    "            imgs = imgs[:spl['test_n']]\n",
    "    pairs = []\n",
    "    for ip in imgs:\n",
    "        mp = None\n",
    "        if msk_dir:\n",
    "            for ext in IMG_EXTS:\n",
    "                cand = Path(msk_dir) / (ip.stem + ext)\n",
    "                if cand.exists():\n",
    "                    mp = cand\n",
    "                    break\n",
    "        pairs.append((ip, mp))\n",
    "    return pairs\n",
    "\n",
    "print(f'Metric functions ready. THRESH={THRESH}')"
   ]
  },
