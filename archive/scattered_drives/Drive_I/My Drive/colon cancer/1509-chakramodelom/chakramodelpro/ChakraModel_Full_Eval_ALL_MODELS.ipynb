    "# CELL 8 — FPS benchmark\n",
    "import time\n",
    "\n",
    "def bench_fps(model, size=384, n=50, warmup=10):\n",
    "    x = torch.randn(1, 3, size, size, device='cuda')\n",
    "    with torch.no_grad():\n",
    "        for _ in range(warmup):\n",
    "            with torch.amp.autocast('cuda', torch.float16):\n",
    "                model(x)\n",
    "    torch.cuda.synchronize()\n",
    "    t0 = time.perf_counter()\n",
    "    with torch.no_grad():\n",
    "        for _ in range(n):\n",
    "            with torch.amp.autocast('cuda', torch.float16):\n",
    "                model(x)\n",
    "    torch.cuda.synchronize()\n",
    "    return n / (time.perf_counter() - t0)\n",
    "\n",
    "fps_results = {}\n",
    "print('FPS @ 384px, bs=1, FP16 (single T4):')\n",
    "for name, model in [\n",
    "    ('ChakraTransformer', vit_model),\n",
    "    ('ChakraNet-AdaBN',   chakranet_adabn),\n",
    "    ('ChakraNet-Topo',    chakranet_topo),\n",
    "    ('ChakraNet-Focal',   chakranet_focal),\n",
    "]:\n",
    "    try:\n",
    "        fps = bench_fps(model)\n",
    "        fps_results[name] = fps\n",
    "        print(f'  {name:30s}: {fps:7.2f} FPS')\n",
    "    except Exception as e:\n",
    "        fps_results[name] = None\n",
    "        print(f'  {name:30s}: FAILED — {e}')\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "# YOLO\n",
    "dummy = np.zeros((384,384,3), dtype=np.uint8)\n",
    "t0 = time.perf_counter()\n",
    "for _ in range(50): yolo_model(dummy, verbose=False)\n",
    "yolo_fps = 50 / (time.perf_counter() - t0)\n",
    "fps_results['YOLOv8n-Seg'] = yolo_fps\n",
    "print(f'  {\"YOLOv8n-Seg\":30s}: {yolo_fps:7.2f} FPS')"
   ]
