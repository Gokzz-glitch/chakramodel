   "id": "cell-07-infer",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELL 7 — Unified inference + evaluation loop\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_seg(model, img_bgr, use_tta=False, use_amp=True):\n",
    "    H, W = img_bgr.shape[:2]\n",
    "    t = preprocess(img_bgr).cuda()\n",
    "    with torch.amp.autocast('cuda', dtype=torch.float16) if use_amp else torch.no_grad():\n",
    "        if use_tta:\n",
    "            ys = []\n",
    "            for hf, vf in [(False,False),(True,False),(False,True),(True,True)]:\n",
    "                inp = t\n",
    "                if hf: inp = torch.flip(inp,[3])\n",
    "                if vf: inp = torch.flip(inp,[2])\n",
    "                y = torch.sigmoid(model(inp))\n",
    "                if hf: y = torch.flip(y,[3])\n",
    "                if vf: y = torch.flip(y,[2])\n",
    "                ys.append(y)\n",
    "            prob = torch.stack(ys).mean(0)[0,0].float().cpu().numpy()\n",
    "        else:\n",
    "            prob = torch.sigmoid(model(t))[0,0].float().cpu().numpy()\n",
    "    prob = cv2.resize(prob, (W, H), interpolation=cv2.INTER_LINEAR)\n",
    "    return (prob > THRESH).astype(np.uint8)\n",
    "\n",
    "def eval_model(model_fn, ds_name, max_images=None):\n",
    "    pairs = get_test_images(ds_name)\n",
    "    if max_images:\n",
    "        pairs = pairs[:max_images]\n",
    "    dices, ious, fbs, pos_rates = [], [], [], []\n",
    "    has_gt = DATASETS[ds_name]['msk'] is not None\n",
    "    for img_path, msk_path in tqdm(pairs, desc=ds_name, leave=False):\n",
    "        img = cv2.imread(str(img_path))\n",
    "        if img is None: continue\n",
    "        try:\n",
    "            pred = model_fn(img)\n",
    "        except Exception as e:\n",
    "            print(f'  Error on {img_path.name}: {e}')\n",
    "            continue\n",
    "        pos_rates.append(int(pred.sum() > 0))\n",
    "        if has_gt and msk_path is not None:\n",
    "            msk = cv2.imread(str(msk_path), cv2.IMREAD_GRAYSCALE)\n",
    "            if msk is None: continue\n",
    "            gt = (msk > 127).astype(np.uint8)\n",
    "            pred_rs = cv2.resize(pred.astype(np.float32), (gt.shape[1], gt.shape[0]),\n",
    "                                 interpolation=cv2.INTER_NEAREST).astype(np.uint8)\n",
    "            dices.append(dice(pred_rs, gt))\n",
    "            ious.append(iou(pred_rs, gt))\n",
    "            fbs.append(fbeta(pred_rs, gt))\n",
    "    r = {\n",
    "        'n': len(pairs), 'n_gt': len(dices),\n",
    "        'positive_rate': float(np.mean(pos_rates)) if pos_rates else None,\n",
    "        'dice': float(np.mean(dices)) if dices else None,\n",
    "        'iou':  float(np.mean(ious))  if ious  else None,\n",
    "        'fbeta': float(np.mean(fbs))  if fbs   else None,\n",
    "    }\n",
    "    return r\n",
    "\n",
    "print('Evaluation loop ready.')"
   ]
