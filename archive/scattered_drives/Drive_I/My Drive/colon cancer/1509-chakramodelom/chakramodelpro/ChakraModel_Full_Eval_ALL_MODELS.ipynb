   "id": "cell-05-chakranet",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CELL 5 — ChakraNet (ResNet50 + RFB + Reverse Attention)\n",
    "import torchvision.models as tvm\n",
    "\n",
    "class BasicConv2d(nn.Module):\n",
    "    def __init__(self, in_c, out_c, k, stride=1, padding=0, dilation=1):\n",
    "        super().__init__()\n",
    "        self.conv = nn.Conv2d(in_c, out_c, k, stride, padding, dilation, bias=False)\n",
    "        self.bn = nn.BatchNorm2d(out_c)\n",
    "        self.relu = nn.ReLU(True)\n",
    "    def forward(self, x):\n",
    "        return self.relu(self.bn(self.conv(x)))\n",
    "\n",
    "class RFB(nn.Module):\n",
    "    def __init__(self, in_c, out_c):\n",
    "        super().__init__()\n",
    "        self.b0 = nn.Sequential(BasicConv2d(in_c, out_c, 1))\n",
    "        self.b1 = nn.Sequential(BasicConv2d(in_c,out_c,1),\n",
    "            BasicConv2d(out_c,out_c,(1,3),padding=(0,1)),\n",
    "            BasicConv2d(out_c,out_c,(3,1),padding=(1,0)),\n",
    "            BasicConv2d(out_c,out_c,3,padding=3,dilation=3))\n",
    "        self.b2 = nn.Sequential(BasicConv2d(in_c,out_c,1),\n",
    "            BasicConv2d(out_c,out_c,(1,5),padding=(0,2)),\n",
    "            BasicConv2d(out_c,out_c,(5,1),padding=(2,0)),\n",
    "            BasicConv2d(out_c,out_c,3,padding=5,dilation=5))\n",
    "        self.b3 = nn.Sequential(BasicConv2d(in_c,out_c,1),\n",
    "            BasicConv2d(out_c,out_c,(1,7),padding=(0,3)),\n",
    "            BasicConv2d(out_c,out_c,(7,1),padding=(3,0)),\n",
    "            BasicConv2d(out_c,out_c,3,padding=7,dilation=7))\n",
    "        self.cat = BasicConv2d(4*out_c, out_c, 3, padding=1)\n",
    "        self.res = BasicConv2d(in_c, out_c, 1)\n",
    "        self.relu = nn.ReLU(True)\n",
    "    def forward(self, x):\n",
    "        return self.relu(self.cat(torch.cat([self.b0(x),self.b1(x),self.b2(x),self.b3(x)],1))+self.res(x))\n",
    "\n",
    "class RA(nn.Module):\n",
    "    def __init__(self, in_c, out_c):\n",
    "        super().__init__()\n",
    "        self.c1 = BasicConv2d(in_c, out_c, 3, padding=1)\n",
    "        self.c2 = BasicConv2d(out_c, out_c, 3, padding=1)\n",
    "        self.c3 = nn.Conv2d(out_c, 1, 1)\n",
    "    def forward(self, x, sal):\n",
    "        return self.c3(self.c2(self.c1(x * (1.0 - torch.sigmoid(sal)).expand_as(x))))\n",
    "\n",
    "class ChakraNet(nn.Module):\n",
    "    def __init__(self, channel=32):\n",
    "        super().__init__()\n",
    "        enc = tvm.resnet50(weights=None)\n",
    "        self.stem   = nn.Sequential(enc.conv1, enc.bn1, enc.relu, enc.maxpool)\n",
    "        self.layer1 = enc.layer1\n",
    "        self.layer2 = enc.layer2\n",
    "        self.layer3 = enc.layer3\n",
    "        self.layer4 = enc.layer4\n",
    "        self.rfb2   = RFB(512,  channel)\n",
    "        self.rfb3   = RFB(1024, channel)\n",
    "        self.rfb4   = RFB(2048, channel)\n",
    "        self.ppd    = nn.Sequential(\n",
    "            BasicConv2d(3*channel, channel, 3, padding=1),\n",
    "            nn.Conv2d(channel, 1, 1)\n",
    "        )\n",
    "        self.ra4 = RA(2048, channel)\n",
    "        self.ra3 = RA(1024, channel)\n",
    "        self.ra2 = RA(512,  channel)\n",
    "\n",
    "    def forward(self, x):\n",
    "        H, W = x.shape[2:]\n",
    "        x0 = self.stem(x)\n",
    "        x1 = self.layer1(x0)\n",
    "        x2 = self.layer2(x1)\n",
    "        x3 = self.layer3(x2)\n",
    "        x4 = self.layer4(x3)\n",
    "        r2, r3, r4 = self.rfb2(x2), self.rfb3(x3), self.rfb4(x4)\n",
    "        sz = r4.shape[2:]\n",
    "        cat = torch.cat([\n",
    "            F.interpolate(r2, sz, mode='bilinear', align_corners=False),\n",
    "            F.interpolate(r3, sz, mode='bilinear', align_corners=False),\n",
    "            r4\n",
    "        ], dim=1)\n",
    "        sal = self.ppd(cat)\n",
    "        sal_4 = F.interpolate(sal, x4.shape[2:], mode='bilinear', align_corners=False)\n",
    "        sal = sal + self.ra4(x4, sal_4)\n",
    "        sal_3 = F.interpolate(sal, x3.shape[2:], mode='bilinear', align_corners=False)\n",
    "        sal = self.ra3(x3, sal_3) + sal_3\n",
    "        sal_2 = F.interpolate(sal, x2.shape[2:], mode='bilinear', align_corners=False)\n",
    "        sal = self.ra2(x2, sal_2) + sal_2\n",
    "        return F.interpolate(sal, (H,W), mode='bilinear', align_corners=False)\n",
    "\n",
    "def load_chakranet(wpath, label, channel=32):\n",
    "    m = ChakraNet(channel=channel)\n",
    "    # PyTorch Lightning saves dirs as archive dirs; load with torch.load on the dir path\n",
    "    try:\n",
    "        sd = torch.load(wpath, map_location='cpu', weights_only=False)\n",
    "    except IsADirectoryError:\n",
    "        # Try loading the first .pth inside\n",
    "        pths = list(Path(wpath).glob('*.pth'))\n",
    "        if not pths:\n",
    "            pths = list(Path(wpath).glob('*.pt'))\n",
    "        sd = torch.load(str(pths[0]), map_location='cpu', weights_only=False)\n",
    "    if isinstance(sd, dict):\n",
    "        if 'model_state_dict' in sd:\n",
    "            epoch = sd.get('epoch','?')\n",
    "            sd = sd['model_state_dict']\n",
    "        elif 'state_dict' in sd:\n",
    "            epoch = sd.get('epoch','?')\n",
    "            sd = sd['state_dict']\n",
    "        else:\n",
    "            epoch = '?'\n",
    "    sd = {k.replace('module.','').replace('_orig_mod.',''): v for k,v in sd.items()}\n",
    "    miss, unex = m.load_state_dict(sd, strict=False)\n",
    "    n = sum(p.numel() for p in m.parameters())\n",
    "    print(f'{label}: epoch={epoch} | {n/1e6:.2f}M | miss={len(miss)} unex={len(unex)}')\n",
    "    return m.cuda().eval()\n",
    "\n",
    "chakranet_adabn = load_chakranet(WEIGHTS['adabn'], 'ChakraNet-AdaBN')\n",
    "chakranet_topo  = load_chakranet(WEIGHTS['topo'],  'ChakraNet-Topo')\n",
    "chakranet_focal = load_chakranet(WEIGHTS['focal'], 'ChakraNet-Focal')\n",
    "print('All ChakraNet variants loaded.')"
   ]
  },
