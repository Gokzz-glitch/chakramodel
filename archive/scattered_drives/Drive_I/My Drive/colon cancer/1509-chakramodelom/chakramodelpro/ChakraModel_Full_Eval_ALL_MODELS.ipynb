    "# CELL 4 — Load ChakraTransformer (ViT-L/16)\n",
    "import timm\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "\n",
    "class ChakraTransformer(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.backbone = timm.create_model('vit_large_patch16_384',\n",
    "            pretrained=False, img_size=384, num_classes=0)\n",
    "        embed = self.backbone.embed_dim  # 1024\n",
    "        self.decode_head = nn.Sequential(\n",
    "            nn.ConvTranspose2d(embed, 256, 4, stride=4),\n",
    "            nn.BatchNorm2d(256), nn.ReLU(True),\n",
    "            nn.ConvTranspose2d(256, 64, 4, stride=4),\n",
    "            nn.BatchNorm2d(64), nn.ReLU(True),\n",
    "            nn.Conv2d(64, 1, 3, padding=1)\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        B, C, H, W = x.shape\n",
    "        feats = self.backbone.forward_features(x)\n",
    "        if feats.dim() == 3:\n",
    "            if feats.shape[1] == (H//16)*(W//16) + 1:\n",
    "                feats = feats[:, 1:]\n",
    "            feats = feats.transpose(1,2).view(B, -1, H//16, W//16)\n",
    "        logits = self.decode_head(feats)\n",
    "        if logits.shape[2:] != (H, W):\n",
    "            logits = F.interpolate(logits, (H,W), mode='bilinear', align_corners=False)\n",
    "        return logits\n",
    "\n",
    "vit_model = ChakraTransformer()\n",
    "sd_raw = torch.load(WEIGHTS['chakra_transformer'], map_location='cpu', weights_only=False)\n",
    "if isinstance(sd_raw, dict) and 'model_state_dict' in sd_raw:\n",
    "    sd_raw = sd_raw['model_state_dict']\n",
    "sd = {k.replace('module.','').replace('_orig_mod.',''): v for k,v in sd_raw.items()}\n",
    "miss, unex = vit_model.load_state_dict(sd, strict=False)\n",
    "vit_model = vit_model.cuda().eval()\n",
    "n = sum(p.numel() for p in vit_model.parameters())\n",
    "print(f'ChakraTransformer: {n/1e6:.2f}M params | missing={len(miss)} unexpected={len(unex)}')"
   ]
